rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function allowedUser() {
      return signedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email.matches("^j\\.?h\\.?f\\.?d\\.?a\\.?v\\.?i\\.?d\\.?s\\.?o\\.?n(\\+.*)?@(gmail\\.com|googlemail\\.com)$")
          || request.auth.token.email.matches("^markwestonarnold(\\+.*)?@(gmail\\.com|googlemail\\.com)$")
          || request.auth.token.email.matches(".*@intuety\\.io$")
        );
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isHost(roomId) {
      return allowedUser() && room(roomId).data.hostUid == request.auth.uid;
    }

    function isParticipant(roomId) {
      return allowedUser()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid));
    }

    function canSendHurryUp(roomId) {
      return isParticipant(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hurryUpAt", "hurryUpByUid", "updatedAt"])
        && request.resource.data.hurryUpAt is number
        && request.resource.data.hurryUpByUid == request.auth.uid;
    }

    function canThrowPaper(roomId) {
      return isParticipant(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "throwPaperAt",
          "throwPaperFromUid",
          "throwPaperToUid",
          "throwPaperTargetMood",
          "updatedAt"
        ])
        && request.resource.data.throwPaperAt is number
        && request.resource.data.throwPaperFromUid == request.auth.uid
        && request.resource.data.throwPaperToUid is string
        && request.resource.data.throwPaperToUid != request.auth.uid
        && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.resource.data.throwPaperToUid))
        && request.resource.data.throwPaperTargetMood in ["sad", "angry"];
    }

    function previousHostMissing(roomId) {
      return room(roomId).data.hostUid == null
        || !exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(room(roomId).data.hostUid));
    }

    function canClaimHost(roomId) {
      return allowedUser()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["hostUid", "updatedAt"])
        && previousHostMissing(roomId);
    }

    match /rooms/{roomId} {
      allow read: if allowedUser();

      allow create: if allowedUser()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.revealed == false
        && request.resource.data.round == 1;

      allow update: if isHost(roomId) || canClaimHost(roomId) || canSendHurryUp(roomId) || canThrowPaper(roomId);
      allow delete: if false;

      match /participants/{userId} {
        allow read: if allowedUser();

        allow create: if allowedUser()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid;

        allow update: if allowedUser() && (
          (request.auth.uid == userId && request.resource.data.uid == request.auth.uid)
          || isHost(roomId)
        );

        allow delete: if allowedUser() && (request.auth.uid == userId || isHost(roomId));
      }
    }
  }
}
